{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "PORT",
    "ANTHROPIC_API_KEY",
    "GEMINI_API_KEY",
    "X402_NETWORK",
    "X402_FACILITATOR_URL",
    "X402_PAY_TO_ACCOUNT_ID",
    "X402_ASSET_ID",
    "SESSION_JWT_SECRET",
    "ENS_RPC_URL",
    "ENS_PARENT_NAME",
    "ENS_SESSION_LABEL",
    "ENS_AGENT_REGISTRY",
    "ENS_AGENT_RESOLVER",
    "ENS_SESSION_REGISTRY",
    "ENS_SESSION_RESOLVER",
    "ENS_OPERATOR_PRIVATE_KEY",
    "ENS_DEPLOY_BLOCK",
    "ENS_GATEWAY_URL",
    "NEXT_PUBLIC_GATEWAY_URL",
    "NEXT_PUBLIC_X402_NETWORK"
  ],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", ".next/**", "!.next/cache/**"] },
    "typecheck": { "dependsOn": ["^build"] },
    "lint": {},
    "db:generate": { "cache": false },
    "db:push": { "cache": false },
    "db:migrate": { "cache": false },
    "dev": { "cache": false, "persistent": true }
  }
}
