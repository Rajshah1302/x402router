# ---------------------------------------------------------------------------
# Router402
# ---------------------------------------------------------------------------

# Neon Postgres (pooled connection string)
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/router402?sslmode=require"

# --- Inference providers ---------------------------------------------------
# Optional. A set key makes the real provider serve that half of the
# catalogue; leave blank to route it through DeepSeek instead.
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# DeepSeek fallback, used whenever the keys above are blank.
DEEPSEEK_API_KEY="sk-..."
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-flash"

# --- x402 / Hedera ---------------------------------------------------------
# hedera:testnet or hedera:mainnet
X402_NETWORK="hedera:testnet"
# BlockyDevs facilitator
X402_FACILITATOR_URL="https://api.testnet.blocky402.com"
# Hedera account that receives inference payments
X402_PAY_TO_ACCOUNT_ID="0.0.123456"
# Asset callers pay in. HBAR (0.0.0) is native and needs no token
# association; an HTS token (testnet USDC = 0.0.429274) requires it.
X402_ASSET_ID="0.0.0"
# USD value of one HBAR, used when the asset is HBAR.
X402_HBAR_USD_PRICE="0.05"
# Gateway margin over upstream provider cost, as a fraction (0.1 = 10%)
X402_MARGIN="0.1"

# --- Gateway ---------------------------------------------------------------
PORT="4021"
# Signs session tokens. Generate with: openssl rand -hex 32
SESSION_JWT_SECRET="change-me-32-bytes-minimum-secret"
# Encrypts harness private keys at rest. Optional; falls back to SESSION_JWT_SECRET.
# HARNESS_SECRET="change-me-32-bytes-minimum-secret"
# Comma-separated origins allowed to call the gateway from a browser
CORS_ORIGINS="http://localhost:3000"

# --- Web -------------------------------------------------------------------
NEXT_PUBLIC_GATEWAY_URL="http://localhost:4021"
NEXT_PUBLIC_X402_NETWORK="hedera:testnet"
# Must match the gateway's settlement asset so client-side spend controls agree.
NEXT_PUBLIC_X402_ASSET="0.0.0"
NEXT_PUBLIC_X402_ASSET_SYMBOL="HBAR"
NEXT_PUBLIC_X402_ASSET_DECIMALS="8"
NEXT_PUBLIC_X402_ASSET_USD_PRICE="0.05"
