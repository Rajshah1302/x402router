# ---------------------------------------------------------------------------
# Router402
# ---------------------------------------------------------------------------

# Neon Postgres (pooled connection string)
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/router402?sslmode=require"

# --- Inference providers ---------------------------------------------------
# Optional. A set key makes the real provider serve that half of the
# catalogue; leave blank to route it through DeepSeek instead.
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# DeepSeek fallback, used whenever the keys above are blank.
DEEPSEEK_API_KEY="sk-..."
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-flash"

# --- x402 / Hedera ---------------------------------------------------------
# hedera:testnet or hedera:mainnet
X402_NETWORK="hedera:testnet"
# BlockyDevs facilitator
X402_FACILITATOR_URL="https://api.testnet.blocky402.com"
# Hedera account that receives inference payments
X402_PAY_TO_ACCOUNT_ID="0.0.123456"
# Asset callers pay in. HBAR (0.0.0) is native and needs no token
# association; an HTS token (testnet USDC = 0.0.429274) requires it.
X402_ASSET_ID="0.0.0"
# USD value of one HBAR, used when the asset is HBAR.
X402_HBAR_USD_PRICE="0.05"
# Gateway margin over upstream provider cost, as a fraction (0.1 = 10%)
X402_MARGIN="0.1"

# --- Gateway ---------------------------------------------------------------
PORT="4021"
# Signs session tokens. Generate with: openssl rand -hex 32
SESSION_JWT_SECRET="change-me-32-bytes-minimum-secret"
# Encrypts harness private keys at rest. Optional; falls back to SESSION_JWT_SECRET.
# HARNESS_SECRET="change-me-32-bytes-minimum-secret"
# Comma-separated origins allowed to call the gateway from a browser
CORS_ORIGINS="http://localhost:3000"

# --- HCS audit trail (optional) --------------------------------------------
# Publish every settlement to a public Hedera Consensus Service topic so the
# payment history is verifiable by anyone. Off unless all three are set.
#   bun run scripts/create-audit-topic.ts <operatorAccountId> <operatorPrivateKey>
HCS_AUDIT_TOPIC_ID=""
HCS_AUDIT_OPERATOR_ID=""
HCS_AUDIT_OPERATOR_KEY=""

# --- Web -------------------------------------------------------------------
NEXT_PUBLIC_GATEWAY_URL="http://localhost:4021"
NEXT_PUBLIC_X402_NETWORK="hedera:testnet"
# Must match the gateway's settlement asset so client-side spend controls agree.
NEXT_PUBLIC_X402_ASSET="0.0.0"
NEXT_PUBLIC_X402_ASSET_SYMBOL="HBAR"
NEXT_PUBLIC_X402_ASSET_DECIMALS="8"
NEXT_PUBLIC_X402_ASSET_USD_PRICE="0.05"

# ─── ENSv2 (Sepolia beta) ────────────────────────────────────────────────────
# Optional. Without these the gateway serves its built-in model catalogue and
# sessions live only in Postgres. With them, the catalogue is read from ENS at
# runtime and every session is registered as an expiring, revocable,
# non-transferable name. Run `bun run --cwd packages/ens ens:deploy` to create
# the registries, then paste the block it prints here. See docs/ens.md.

# Verified working with no signup. Note that sepolia.drpc.org does NOT serve
# Sepolia on its free plan — it answers "chain is not available".
ENS_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# A .eth name you own on the ENSv2 Sepolia beta, registered at app.ens.dev
# with the same address as ENS_OPERATOR_PRIVATE_KEY below.
ENS_PARENT_NAME=router402.eth
# Label whose subregistry holds session names: <session>.keys.router402.eth
ENS_SESSION_LABEL=keys
ENS_AGENT_REGISTRY=
ENS_AGENT_RESOLVER=
ENS_SESSION_REGISTRY=
ENS_SESSION_RESOLVER=
# Burner Sepolia key that registers and unregisters names. Read-only without
# it. Never reuse a key that touches mainnet — this sits here in plaintext.
ENS_OPERATOR_PRIVATE_KEY=
# Block the registries were deployed at; bounds the log scan that lists agents.
ENS_DEPLOY_BLOCK=
# Base URL published in each agent's `url` record.
ENS_GATEWAY_URL=http://localhost:4021
