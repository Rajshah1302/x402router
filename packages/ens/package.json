{
  "name": "@router402/ens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json",
    "ens:deploy": "tsx scripts/deploy.ts",
    "ens:publish": "tsx scripts/publish-catalogue.ts",
    "ens:mint": "tsx scripts/mint-test-stablecoin.ts",
    "ens:mint-usdc": "tsx scripts/mint-usdc.ts",
    "ens:verify": "tsx scripts/verify.ts",
    "ens:catalogue": "tsx scripts/show-catalogue.ts"
  },
  "dependencies": {
    "@router402/shared": "workspace:*",
    "dotenv": "^17.2.2",
    "viem": "^2.56.5",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.18.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3"
  }
}
